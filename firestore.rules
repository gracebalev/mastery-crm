rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'alex@themasterycompany.com',
          'olga@themasterycompany.com',
          'grace@themasterycompany.com'
        ];
    }

    match /companies/{companyId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read, create, update, delete: if signedIn();
    }

    match /events/{eventId} {
      allow read, create, update, delete: if signedIn();
    }

    match /contactEmailIndex/{emailKey} {
      allow read, create, update, delete: if signedIn();
    }

    match /contactIdentityIndex/{identityKey} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
